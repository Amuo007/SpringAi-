                        SpringAI
                    </h5>
                    <p>A tool for creating interactive website guides.</p>
                </div>
                <div class="col-lg-2 mb-4 mb-lg-0">
                    <h6 class="text-white">Links</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-muted">About</a></li>
                        <li><a href="/#features" class="text-muted">Features</a></li>
                        <li><a href="#" class="text-muted">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 mb-4 mb-lg-0">
                    <h6 class="text-white">Legal</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-muted">Terms</a></li>
                        <li><a href="#" class="text-muted">Privacy</a></li>
                        <li><a href="#" class="text-muted">Cookies</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="text-white">Stay Connected</h6>
                    <div class="d-flex gap-3 mb-3">
                        <a href="#" class="text-white"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-linkedin-in"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-4 bg-light opacity-25">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="small mb-md-0">© 2025 SpringAI. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a href="/auth/login" class="text-white small">Sign In</a>
